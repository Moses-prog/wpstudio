# WP Studio Production Configuration
# Copy this file to .env and populate the required values.

# 1. Supabase Cloud Configuration (PostgreSQL Database & State)
SUPABASE_URL="https://your-project-id.supabase.co"
SUPABASE_KEY="your-supabase-service-role-or-anon-key"

# 2. Google Gemini AI Engine
DEFAULT_GEMINI_API_KEY="your-gemini-api-key-here"

# 3. Telegram Bot & MTProto API Credentials (from https://my.telegram.org)
API_ID="your_telegram_api_id"
API_HASH="your_telegram_api_hash"
BOT_TOKEN="your_telegram_bot_token"

# 4. Web Studio & Mini App Host Settings
PORT=8085
WEB_APP_URL="https://your-domain.com/miniapp"
